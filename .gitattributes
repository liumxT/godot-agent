* text=auto eol=lf

*.py text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows 批处理必须 CRLF，否则 cmd.exe 解析失败
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.ttf binary
*.exe binary
*.zip binary
