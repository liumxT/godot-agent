# 复制为 .env 后按需修改；.env 不入库。
# 所有变量使用 GODOT_AI_ 前缀。

# 运行环境：development / test / production
GODOT_AI_ENVIRONMENT=development

# 仅允许绑定回环地址
GODOT_AI_HOST=127.0.0.1
GODOT_AI_PORT=8765

# 日志级别：DEBUG / INFO / WARNING / ERROR
GODOT_AI_LOG_LEVEL=INFO

# 必填项，缺失将导致启动失败并给出明确错误
GODOT_AI_DATABASE_URL=sqlite+aiosqlite:///./data/backend.db
