# 复制为 .env 后按需修改；.env 不入库。
# 所有变量使用 GODOT_AI_ 前缀。
#
# 注意：API Key / Token / 密码一律不写入本文件，
# 统一存入操作系统凭证库（Windows Credential Manager），
# 见 docs/03-development/secrets.md。

# 运行环境：development / test / production
GODOT_AI_ENVIRONMENT=development

# 仅允许绑定回环地址（127.0.0.1 / ::1 / localhost）
GODOT_AI_HOST=127.0.0.1
GODOT_AI_PORT=8765

# 数据目录与数据库（必填项，缺失将导致启动失败并给出明确错误）
GODOT_AI_DATA_DIR=data
GODOT_AI_DATABASE_URL=sqlite+aiosqlite:///./data/backend.db

# 日志：级别 DEBUG / INFO / WARNING / ERROR / CRITICAL
GODOT_AI_LOG_LEVEL=INFO
GODOT_AI_LOG_DIR=logs

# 模型 Provider 选择位（具体 Provider 由 E4 定义；未启用填 none）
GODOT_AI_MODEL_PROVIDER=none
