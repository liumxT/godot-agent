# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 构建产物
dist/
build/
*.spec
!scripts/release/*.spec

# 本地数据库与运行数据
data/
logs/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 密钥与本地配置（绝不入库）
.env
.env.*
!.env.example
/secrets/
*.pem
*.key
*.pfx

# Godot
.godot/
.import/
export/
*.translation
*.tmp

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.log
*.bak
.screenshots/
artifacts/

# 本地工具链（Godot 可执行文件等，不入库）
.tools/

# 产品发布产物（由 scripts/release/build_product.py 生成，二进制不入库）
/release/*
!/release/README.md

# Demo 证据日志必须入库（E11 验收依赖）
!demo/platformer/reports/evidence/*.log
