{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.godot-ai.local/api/response.schema.json",
  "title": "Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "success", "data", "error"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": ["object", "null"]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/error" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "success": { "const": true } },
        "required": ["success"]
      },
      "then": {
        "properties": { "error": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "success": { "const": false } },
        "required": ["success"]
      },
      "then": {
        "properties": { "error": { "$ref": "#/$defs/error" } }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details", "retryable", "correlation_id"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "details": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      }
    }
  }
}
