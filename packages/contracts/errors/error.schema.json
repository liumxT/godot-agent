{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.godot-ai.local/errors/error.schema.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "details", "retryable", "correlation_id"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    }
  }
}
