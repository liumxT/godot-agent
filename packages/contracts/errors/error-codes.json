{
  "version": "1.0",
  "codes": [
    {
      "code": "PROTOCOL_VERSION_UNSUPPORTED",
      "retryable": false,
      "http_status": 400,
      "description": "对端协议版本不受支持，需要升级插件或后端。"
    },
    {
      "code": "INVALID_REQUEST",
      "retryable": false,
      "http_status": 400,
      "description": "请求结构不合法（缺字段、类型错误、格式错误）。"
    },
    {
      "code": "VALIDATION_FAILED",
      "retryable": false,
      "http_status": 422,
      "description": "payload 未通过业务校验。"
    },
    {
      "code": "UNAUTHORIZED",
      "retryable": false,
      "http_status": 401,
      "description": "缺少或无效的本地认证凭证。"
    },
    {
      "code": "NOT_FOUND",
      "retryable": false,
      "http_status": 404,
      "description": "目标资源不存在。"
    },
    {
      "code": "CONFLICT",
      "retryable": false,
      "http_status": 409,
      "description": "资源状态冲突，例如文件已被修改或存在资源锁。"
    },
    {
      "code": "RESOURCE_LOCKED",
      "retryable": true,
      "http_status": 423,
      "description": "资源被其他任务锁定，可在锁释放后重试。"
    },
    {
      "code": "RATE_LIMITED",
      "retryable": true,
      "http_status": 429,
      "description": "触发限流，应退避后重试。"
    },
    {
      "code": "TIMEOUT",
      "retryable": true,
      "http_status": 504,
      "description": "下游调用超时。"
    },
    {
      "code": "DEPENDENCY_UNAVAILABLE",
      "retryable": true,
      "http_status": 503,
      "description": "依赖服务不可用，例如模型 Provider 或 Godot Runtime。"
    },
    {
      "code": "NOT_IMPLEMENTED",
      "retryable": false,
      "http_status": 501,
      "description": "该 action 尚未实现。"
    },
    {
      "code": "INTERNAL_ERROR",
      "retryable": false,
      "http_status": 500,
      "description": "未预期的内部错误，需要查看日志。"
    }
  ]
}
