{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_pipeline/asset_license.schema.json",
  "title": "AssetLicense",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "license_id",
    "asset_version_id",
    "license_name",
    "source_type",
    "verification_status"
  ],
  "properties": {
    "license_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "asset_version_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "license_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "license_family": {"type": ["string", "null"], "maxLength": 64},
    "source_type": {
      "enum": [
        "USER_CREATED",
        "USER_UPLOADED",
        "AI_GENERATED",
        "EXTERNAL_PURCHASED",
        "OPEN_SOURCE",
        "PUBLIC_DOMAIN",
        "PROJECT_DERIVED",
        "PROCEDURAL_GENERATED",
        "UNKNOWN_SOURCE"
      ]
    },
    "source_reference": {"type": ["string", "null"], "maxLength": 512},
    "commercial_use": {"type": ["boolean", "null"]},
    "modification_allowed": {"type": ["boolean", "null"]},
    "redistribution_allowed": {"type": ["boolean", "null"]},
    "attribution_required": {"type": ["boolean", "null"]},
    "attribution_text": {"type": ["string", "null"]},
    "expiration_at": {"type": ["string", "null"], "format": "date-time"},
    "territory": {"type": ["string", "null"], "maxLength": 128},
    "evidence_reference": {"type": ["string", "null"], "maxLength": 512},
    "verification_status": {
      "enum": ["UNKNOWN", "PENDING_REVIEW", "VERIFIED", "REJECTED", "EXPIRED", "RESTRICTED"]
    },
    "reviewer_id": {"type": ["string", "null"], "maxLength": 64},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
