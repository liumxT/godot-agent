; Project Platformer Demo（PF-DEMO-001）
; 引擎版本冻结：Godot 4.5.1
; 输入映射集中在此文件，脚本不得硬编码按键。

config_version=5

[application]

config/name="Project Platformer Demo"
config/description="E11 系统级集成验收 Demo：2D 平台跳跃游戏。"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
ScoreManager="*res://scripts/systems/score_manager.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
GameFlowManager="*res://scripts/core/game_flow_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="hurtbox"
2d_physics/layer_4="hitbox"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.09, 0.12, 0.16, 1)
